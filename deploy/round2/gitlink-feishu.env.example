# Copy to /etc/gitlink/feishu.env with mode 0600. Never commit real values.
FEISHU_APP_ID=cli_replace_me
FEISHU_APP_SECRET=replace_me
GITLINK_INSTALL_GITLINK_TOKEN=replace_me
GITLINK_INSTALL_GITLINK_WEBHOOK_SECRET=replace_me

# Add only when the corresponding opt-in feature is enabled.
